# Copiar como .streamlit/secrets.toml solo en el servidor privado.
# No commitear el archivo real: contiene el secreto de sesión y OAuth.
[auth]
redirect_uri = "https://app.empresa.com/oauth2callback"
cookie_secret = "reemplazar-por-un-secreto-largo-y-aleatorio"
client_id = "google-oauth-client-id.apps.googleusercontent.com"
client_secret = "google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
