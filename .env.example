# Copiar como `.env` (que está en .gitignore) y completar. Nunca commitear el real.

# --- Obligatorias -----------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Solo para sincronizar Google Drive (el ID está en la URL de la carpeta).
GOOGLE_DRIVE_FOLDER_ID=

# Tiene que coincidir con el NEO4J_AUTH del `docker run` (ver docs/setup.md).
# Si Neo4j no está disponible el agente degrada a búsqueda solo vectorial.
NEO4J_PASSWORD=

# Bearer token del webhook local de n8n. Generá uno largo y aleatorio.
N8N_WEBHOOK_TOKEN=

# --- Opcionales (valores por defecto entre paréntesis) ----------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=events_kb
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# Modelos. El agente usa programmatic tool calling, que Haiku 4.5 no soporta,
# por eso CLAUDE_MODEL no debería bajarse a Haiku (ver docs/optimizacion-del-agente.md).
# CLAUDE_MODEL=claude-sonnet-5
# EXTRACTION_MODEL=claude-haiku-4-5-20251001
# OPERATIONS_MODEL=claude-haiku-4-5-20251001
# RERANK_MODEL=rerank-2.5-lite
# RERANK_CANDIDATES=20

# Presupuesto del mapa del grafo y de las citas.
# GRAPH_DEDUP_THRESHOLD=90
# GRAPH_MAX_ANCHORS=5
# GRAPH_MAX_EDGES=40
# GRAPH_MAX_CHARS=1600
# CITATION_MAX_CHARS=2000

# Acceso y red. En desarrollo local la autenticación está desactivada.
# AUTH_REQUIRED=false
# ALLOWED_EMAIL_DOMAIN=empresa.com
# WEBHOOK_HOST=127.0.0.1
# DEVELOPMENT_ACTOR_EMAIL=operaciones@local

# Mantener en false: el módulo comercial heredado no envía mensajes.
# ENABLE_OUTBOUND=false
